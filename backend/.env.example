# KinSpace API configuration
# Copy to .env and adjust. Environment variables take precedence over this file.

ENVIRONMENT=development   # development | production | test
PORT=8080

# PostgreSQL connection string (docker compose exposes 5433 locally)
DATABASE_URL=postgres://kinspace:spacekin@localhost:5433/kinspace?sslmode=disable

# JWT signing secret — must be at least 32 characters, use a random value in production
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL_HOURS=24

# Integration tests only
# TEST_DATABASE_URL=postgres://kinspace:spacekin@localhost:5433/kinspace_test?sslmode=disable
